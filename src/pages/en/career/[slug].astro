---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { getCareerEntries } from "../../../lib/career";
import { careerPath, timelinePath } from "../../../lib/routes";

export function getStaticPaths() {
  return getCareerEntries("en").map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
---

<SiteLayout
  locale="en"
  slug={entry.slug}
  title={`${entry.data.title} | Yichen Xiao`}
  description={entry.data.summary}
>
  <article class="detail-page">
    <a class="back-link" href={timelinePath("en")}>Back to timeline</a>
    <header class="detail-header">
      <p class="period">{entry.data.period}</p>
      <h1>{entry.data.title}</h1>
    </header>
    <section class="detail-section">
      <h2>Project Summary</h2>
      <p class="project-summary">{entry.data.summary}</p>
    </section>
    {entry.data.paper && (
      <section class="detail-section">
        <h2>Paper Information</h2>
        <dl class="paper-list">
          <div>
            <dt>Paper</dt>
            <dd><a href={entry.data.paper.url}>{entry.data.paper.title}</a></dd>
          </div>
          <div>
            <dt>DOI</dt>
            <dd>{entry.data.paper.doi}</dd>
          </div>
          <div>
            <dt>Journal</dt>
            <dd>{entry.data.paper.journal}</dd>
          </div>
        </dl>
      </section>
    )}
    <a class="button" href={careerPath("zh", entry.slug)}>阅读中文版</a>
  </article>
</SiteLayout>

---
import { careerFigures } from "../lib/career-figures";
import type { Locale } from "../lib/routes";

interface Props {
  slug: string;
  locale: Locale;
}

const { slug, locale } = Astro.props;
const figures = careerFigures[slug] ?? [];
const isZh = locale === "zh";
---

{figures.length > 0 && (
  <section class="detail-section career-figures" aria-labelledby="career-figures-heading">
    <h2 id="career-figures-heading">{isZh ? "研究示意" : "Research Illustrations"}</h2>
    <p class="figure-note">
      {isZh
        ? "AI生成·概念示意。点击图片可查看原图。"
        : "AI-generated conceptual illustrations. Click an image to view the full-size version."}
    </p>
    {figures.map((figure) => (
      <figure>
        <a href={figure.src} target="_blank" rel="noopener">
          <img
            src={figure.src}
            alt={figure.alt[locale]}
            width="1672"
            height="941"
            loading="lazy"
            decoding="async"
          />
        </a>
        <figcaption>{figure.caption[locale]}</figcaption>
      </figure>
    ))}
  </section>
)}

<style>
  figure {
    margin: 24px 0 0;
  }

  figure a {
    display: block;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-line);
    background: #fff;
  }

  .figure-note,
  figcaption {
    color: var(--color-muted);
    font-size: 0.88rem;
    line-height: 1.75;
  }

  .figure-note {
    margin-bottom: 0;
  }

  figcaption {
    margin-top: 12px;
  }
</style>

---
import SiteLayout from "../layouts/SiteLayout.astro";
import { homePath, type Locale } from "../lib/routes";
import { profile } from "../lib/profile";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isZh = locale === "zh";
const title = isZh ? `${profile.name} | 博客` : `${profile.nameEn} | Blog`;
const description = isZh
  ? "肖奕晨的非学术文章入口。"
  : "A home for Yichen Xiao's non-academic writing.";
---

<SiteLayout
  locale={locale}
  title={title}
  description={description}
  switchPath={locale === "zh" ? "/en/blog/" : "/blog/"}
>
  <section class="section-page blog-page">
    <a class="back-link" href={homePath(locale)}>{isZh ? "返回首页" : "Back to home"}</a>
    <div class="section-heading">
      <p class="section-kicker">{isZh ? "博客" : "Blog"}</p>
      <h1><span class="heading-mark" aria-hidden="true">✍️</span>{isZh ? "非学术文章" : "Non-Academic Writing"}</h1>
    </div>
    <div class="blog-note">
      <h2>{isZh ? "文章整理中" : "Writing in progress"}</h2>
      <p>
        {isZh
          ? "这里将用于收纳科研之外的阅读、观察、生活记录与阶段性思考。"
          : "This space will collect reading notes, observations, life records, and reflections outside academic work."}
      </p>
    </div>
  </section>
</SiteLayout>

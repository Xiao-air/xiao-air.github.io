---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCareerEntries } from "../lib/career";
import { extracurricularTimeline, groupHonorsByYear, honorsAwards, localize } from "../lib/public-profile";
import { careerPath, type Locale } from "../lib/routes";
import { profile } from "../lib/profile";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isZh = locale === "zh";
const title = isZh ? `${profile.name} | 个人主页` : `${profile.nameEn} | Personal Website`;
const description = isZh
  ? "肖奕晨的个人主页，记录科研探索、学习经历与项目时间线。"
  : "Yichen Xiao's personal website for research explorations, learning experiences, and project timelines.";
const projectEntries = getCareerEntries(locale, "project");
const homeTimelineGroups = {
  project: projectEntries,
  extracurricular: extracurricularTimeline
};
const honorYearGroups = groupHonorsByYear(honorsAwards);
---

<SiteLayout locale={locale} title={title} description={description}>
  <div class="profile-home">
    <aside class="profile-sidebar" aria-label={isZh ? "个人信息" : "Profile"}>
      <div class="profile-identity">
        <img
          class="profile-photo"
          src={profile.photoUrl}
          alt={isZh ? "肖奕晨个人照片" : "Portrait of Yichen Xiao"}
          loading="eager"
        />
        <div>
          <p class="profile-label">Profile</p>
          <h1 class="profile-name">{isZh ? profile.displayName.zh : profile.displayName.en}</h1>
        </div>
      </div>
      <dl class="profile-facts">
        <div>
          <dt>{isZh ? "背景" : "Background"}</dt>
          <dd>
            <ul class="education-list">
              {profile.education.map((item) => (
                <li>
                  <span>{isZh ? item.period : item.periodEn}</span>
                  <strong>{isZh ? item.zh : item.en}</strong>
                </li>
              ))}
            </ul>
          </dd>
        </div>
        <div>
          <dt>{isZh ? "友情连接" : "Link"}</dt>
          <dd>
            <ul class="friend-link-list">
              {profile.friendLinks.map((link) => (
                <li><a class="external-link" href={link.url}>{isZh ? link.zh : link.en}</a></li>
              ))}
            </ul>
          </dd>
        </div>
        <div>
          <dt>{isZh ? "个人邮箱" : "Email"}</dt>
          <dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd>
        </div>
      </dl>
    </aside>

    <div class="profile-main">
      <section class="profile-section">
        <h2><span class="heading-mark" aria-hidden="true">👋</span>{isZh ? "简介" : "About"}</h2>
        <p class="intro-text">{profile.intro[locale]}</p>
      </section>

      <section class="profile-section">
        <h2><span class="heading-mark" aria-hidden="true">🧭</span>{isZh ? "时间线" : "Timeline"}</h2>
        <div class="timeline-groups home-timeline-groups">
          <section class="timeline-group" aria-labelledby="project-home-timeline-heading">
            <div class="timeline-group-heading">
              <h3 id="project-home-timeline-heading">
                <span class="heading-mark" aria-hidden="true">🧪</span>{isZh ? "项目经历" : "Project Experience"}
              </h3>
            </div>
            <ol class="timeline-list">
              {homeTimelineGroups.project.map((entry) => (
                <li class="timeline-item">
                  <article class="timeline-card">
                    <div class="timeline-period">
                      <strong>{entry.data.period}</strong>
                    </div>
                    <div class="timeline-body">
                      <h3><a class="timeline-title-link" href={careerPath(locale, entry.slug)}>{entry.data.title}</a></h3>
                      <p class="project-summary">{entry.data.summary}</p>
                      {entry.data.paper && (
                        <dl class="paper-list">
                          <div>
                            <dt>{isZh ? "论文" : "Paper"}</dt>
                            <dd><a href={entry.data.paper.url}>{entry.data.paper.title}</a></dd>
                          </div>
                          <div>
                            <dt>DOI</dt>
                            <dd>{entry.data.paper.doi}</dd>
                          </div>
                          <div>
                            <dt>{isZh ? "期刊" : "Journal"}</dt>
                            <dd>{entry.data.paper.journal}</dd>
                          </div>
                        </dl>
                      )}
                    </div>
                  </article>
                </li>
              ))}
            </ol>
          </section>

          <section class="timeline-group" aria-labelledby="extracurricular-home-timeline-heading">
            <div class="timeline-group-heading">
              <h3 id="extracurricular-home-timeline-heading">
                <span class="heading-mark" aria-hidden="true">🌱</span>{isZh ? "社会活动与领导经历" : "Leadership & Activities"}
              </h3>
            </div>
            <ol class="year-list">
              {homeTimelineGroups.extracurricular.map((group) => (
                <li class="year-item">
                  <div class="year-label">{group.year}</div>
                  <ul class="activity-list">
                    {group.items.map((item) => (
                      <li>
                        <span>{localize(item.title, locale)}</span>
                        <strong>{localize(item.role, locale)}</strong>
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ol>
          </section>
        </div>
      </section>

      <section class="profile-section">
        <h2><span class="heading-mark" aria-hidden="true">🏅</span>{isZh ? "荣誉奖项" : "Honors & Awards"}</h2>
        <ol class="award-year-list">
          {honorYearGroups.map((group) => (
            <li class="award-year-group">
              <h3 class="award-year-heading">{group.year}</h3>
              <ol class="award-list">
                {group.items.map((award) => (
                  <li>
                    <time>{award.date}</time>
                    <span>{localize(award.title, locale)}</span>
                  </li>
                ))}
              </ol>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </div>
</SiteLayout>

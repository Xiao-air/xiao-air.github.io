---
import SiteLayout from "../layouts/SiteLayout.astro";
import { focusPath, resumePath, skillsPath, timelinePath, type Locale } from "../lib/routes";
import { profile } from "../lib/profile";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isZh = locale === "zh";
const title = isZh ? `${profile.name} | 生涯系统` : `${profile.name} | Career System`;
const description = isZh
  ? "一个以职业时间线、技能资质和当前方向为核心的双语个人网站。"
  : "A bilingual personal site centered on career timeline, skills, credentials, and current focus.";
const systemNotes = isZh
  ? [
      ["Public layer", "公开展示"],
      ["Private vault", "私密复盘"],
      ["Quarterly rhythm", "季度节奏"]
    ]
  : [
      ["Public layer", "Presentation"],
      ["Private vault", "Reflection"],
      ["Quarterly rhythm", "Review cycle"]
    ];
const entryCards = [
  {
    label: isZh ? "职业时间线" : "Career Timeline",
    title: isZh ? "查看经历轨迹" : "Read the career ledger",
    meta: isZh ? "项目 / 阶段 / 公开证据" : "Projects / stages / public evidence",
    href: timelinePath(locale)
  },
  {
    label: isZh ? "技能与资质" : "Skills & Credentials",
    title: isZh ? "浏览能力索引" : "Scan skills and credentials",
    meta: isZh ? "语言 / 工具 / 工作能力" : "Languages / tools / work skills",
    href: skillsPath(locale)
  },
  {
    label: isZh ? "当前关注方向" : "Current Focus",
    title: isZh ? "了解当前 Focus" : "See current focus",
    meta: isZh ? "方向级主题，不含任务清单" : "Direction-level themes, no task list",
    href: focusPath(locale)
  }
];
---

<SiteLayout locale={locale} title={title} description={description}>
  <section class="home-shell">
    <div class="home-identity">
      <p class="eyebrow">{isZh ? "Career system" : "Career system"}</p>
      <h1>{isZh ? "生涯档案" : "Career archive"}</h1>
      <div class="actions" aria-label={isZh ? "主要链接" : "Primary links"}>
        <a class="button primary" href={timelinePath(locale)}>{isZh ? "进入时间线" : "Open timeline"}</a>
        <a class="button" href={resumePath(locale)}>{isZh ? "查看简历" : "Resume"}</a>
        <a class="button" href={profile.githubUrl}>GitHub</a>
      </div>
    </div>
    <aside class="identity-panel" aria-label={isZh ? "个人概览" : "Profile summary"}>
      <img src={profile.avatarUrl} alt={profile.name} width="144" height="144" />
      <div>
        <p class="panel-label">{profile.handle}</p>
        <h2>{profile.name}</h2>
        <p>{isZh ? profile.roleZh : profile.roleEn}</p>
      </div>
      <div class="system-ledger" aria-label={isZh ? "系统结构摘要" : "System structure summary"}>
        {systemNotes.map(([label, value]) => (
          <div>
            <span>{label}</span>
            <strong>{value}</strong>
          </div>
        ))}
      </div>
    </aside>
  </section>

  <section class="gateway-grid" aria-label={isZh ? "子界面入口" : "Subinterface gateway"}>
    {entryCards.map((card) => (
      <a class="gateway-card" href={card.href}>
        <span>{card.label}</span>
        <strong>{card.title}</strong>
        <small>{card.meta}</small>
      </a>
    ))}
  </section>
</SiteLayout>

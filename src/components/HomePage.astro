---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCareerEntries } from "../lib/career";
import { currentFocusThemes, localize, skillCredentialCategories } from "../lib/public-profile";
import { careerPath, focusPath, resumePath, skillsPath, timelinePath, type Locale } from "../lib/routes";
import { profile } from "../lib/profile";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isZh = locale === "zh";
const title = isZh ? `${profile.name} | 生涯系统` : `${profile.name} | Career System`;
const description = isZh
  ? "Yichen Xiao 的公开个人主页与职业记录。"
  : "Yichen Xiao's public personal homepage and career record.";
const entries = getCareerEntries(locale);
const selectedEntries = entries.slice(0, 4);
const projectEntries = entries.slice(0, 3);
const languageCredentials = skillCredentialCategories.find((category) => category.id === "languages")?.items ?? [];
const highlightedSkills = skillCredentialCategories
  .flatMap((category) => category.items)
  .filter((item) => item.id !== "english-cet6" && item.id !== "french-delf-b2")
  .slice(0, 6);
const updates = isZh
  ? [
      ["2026", "搭建公开个人主页与私密职业复盘系统。"],
      ["2026", "持续整理项目经历、技能证据与未来方向。"]
    ]
  : [
      ["2026", "Built a public personal homepage and private career reflection system."],
      ["2026", "Continuing to organize project experience, skills evidence, and future direction."]
    ];
---

<SiteLayout locale={locale} title={title} description={description}>
  <div class="profile-home">
    <aside class="profile-sidebar" aria-label={isZh ? "个人信息" : "Profile"}>
      <h1>{profile.name}</h1>
      <p class="profile-role">{isZh ? profile.roleZh : profile.roleEn}</p>

      <ul class="profile-links">
        <li><a href={profile.githubUrl}>GitHub</a></li>
        <li><a href={resumePath(locale)}>{isZh ? "简历" : "Resume"}</a></li>
        <li><a href={timelinePath(locale)}>{isZh ? "职业时间线" : "Career Timeline"}</a></li>
      </ul>

      <section class="profile-side-section">
        <h2>{isZh ? "语言" : "Languages"}</h2>
        <ul>
          {languageCredentials.map((item) => (
            <li>
              <span>{localize(item.label, locale)}</span>
              {item.credential && <strong>{localize(item.credential, locale)}</strong>}
            </li>
          ))}
        </ul>
      </section>
    </aside>

    <div class="profile-main">
      <section class="profile-section">
        <h2>{isZh ? "简介" : "About"}</h2>
        <p>
          {isZh
            ? "这里记录我的公开职业经历、项目节点、技能资质与当前关注方向。更完整的复盘和未来计划保留在私密工作区，公开网站只呈现经过筛选的经历与证据。"
            : "This site records my public career experience, selected project nodes, skills, credentials, and current focus. Fuller retrospectives and planning notes stay private; the public site only presents reviewed experience and evidence."}
        </p>
      </section>

      <section class="profile-section">
        <h2>{isZh ? "近期更新" : "Updates"}</h2>
        <ul class="news-list">
          {updates.map(([date, text]) => (
            <li>
              <time>{date}</time>
              <span>{text}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="profile-section">
        <div class="section-title-row">
          <h2>{isZh ? "精选经历" : "Selected Experience"}</h2>
          <a href={timelinePath(locale)}>{isZh ? "完整时间线" : "Full timeline"}</a>
        </div>
        <ol class="record-list">
          {selectedEntries.map((entry) => (
            <li>
              <span class="record-date">{entry.data.period}</span>
              <div>
                <h3><a href={careerPath(locale, entry.slug)}>{entry.data.title}</a></h3>
                <p>{entry.data.summary}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="profile-section">
        <h2>{isZh ? "项目" : "Projects"}</h2>
        <ul class="plain-link-list">
          {projectEntries.map((entry) => (
            <li>
              <a href={careerPath(locale, entry.slug)}>{entry.data.title}</a>
              <span>{entry.data.role}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="profile-section">
        <div class="section-title-row">
          <h2>{isZh ? "技能与资质" : "Skills & Credentials"}</h2>
          <a href={skillsPath(locale)}>{isZh ? "查看全部" : "View all"}</a>
        </div>
        <ul class="tag-list">
          {highlightedSkills.map((item) => (
            <li>{localize(item.label, locale)}</li>
          ))}
        </ul>
      </section>

      <section class="profile-section">
        <div class="section-title-row">
          <h2>{isZh ? "当前关注方向" : "Current Focus"}</h2>
          <a href={focusPath(locale)}>{isZh ? "查看方向" : "View focus"}</a>
        </div>
        <ul class="topic-list">
          {currentFocusThemes.map((theme) => (
            <li>
              <strong>{localize(theme.title, locale)}</strong>
              <span>{localize(theme.description, locale)}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</SiteLayout>

---
import "../styles/global.css";
import {
  blogPath,
  homePath,
  languageSwitchPath,
  timelinePath,
  type Locale
} from "../lib/routes";
import { profile } from "../lib/profile";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  slug?: string;
  switchPath?: string;
}

const { locale, title, description, slug, switchPath: providedSwitchPath } = Astro.props;
const isZh = locale === "zh";
const switchPath = providedSwitchPath ?? languageSwitchPath(locale, slug);
const home = homePath(locale);
const timeline = timelinePath(locale);
const blog = blogPath(locale);
const displayName = isZh ? profile.name : profile.nameEn;
const currentPath = Astro.url.pathname;
const navItems = [
  { href: timeline, label: isZh ? "时间线" : "Timeline" },
  { href: blog, label: isZh ? "博客" : "Blog" }
];

function normalizePath(path: string) {
  return path.endsWith("/") ? path : `${path}/`;
}

function isCurrentPath(path: string) {
  return normalizePath(currentPath) === normalizePath(path);
}
---

<!doctype html>
<html lang={isZh ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <link rel="icon" href={profile.avatarUrl} />
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href={home} aria-label={isZh ? "返回首页" : "Back to home"}>
        <span>{displayName}</span>
      </a>
      <nav class="nav" aria-label={isZh ? "主导航" : "Main navigation"}>
        {navItems.map((item) => (
          <a href={item.href} aria-current={isCurrentPath(item.href) ? "page" : undefined}>{item.label}</a>
        ))}
        <a class="language-link" href={switchPath}>{isZh ? "EN" : "中文"}</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="footer">
      <span>{displayName} · {isZh ? "个人主页" : "Personal website"}</span>
      <a href={profile.githubUrl}>GitHub</a>
    </footer>
  </body>
</html>
